{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Draft Assistant",
  "version": "0.3.1",
  "identifier": "com.justin.draft-assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Draft Assistant",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://sleepercdn.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http: ws:"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jtn0123/draft-assistant/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxMjkxMzgyMUVGQkMxQjcKUldTM3dmc2VnaE1wTWR0N0MxVkFzd1kweDQ1Y2NXbWI5azE2anZDZHVleUZWdWNnRjhYU3lxM3QK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
