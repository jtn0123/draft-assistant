{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsnode",
    "strict": true,
    "lib": ["ES2022", "DOM"]
  },
  // The build and test-harness configs, plus the browser end-to-end suite:
  // node-side TypeScript that the app's own project does not include, and
  // that nothing else was typechecking.
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e-browser/**/*.ts"]
}
