{
  "name": "draft-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:loc": "node scripts/check-loc.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "test": "bun run test:frontend && bun run test:rust",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "lint": "bun run lint:frontend && bun run lint:rust",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "verify": "bun run check:loc && bun run format:check && bun run typecheck && bun run build && bun run test && bun run test:e2e && bun run lint",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:e2e": "playwright test",
    "coverage": "bun run coverage:frontend && bun run coverage:rust",
    "coverage:frontend": "vitest run --coverage",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --all-targets --summary-only",
    "fuzz:build": "cargo +nightly fuzz build --manifest-path src-tauri/fuzz/Cargo.toml",
    "build:desktop": "tauri build --no-bundle --features wdio --config '{\"app\":{\"withGlobalTauri\":true}}'",
    "test:desktop": "bun run build:desktop && wdio run wdio.conf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.5",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "webdriverio": "^9.31.5"
  }
}
